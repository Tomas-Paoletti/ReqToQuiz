<!doctype html>
<html lang="{{.Lang}}">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>{{.Quiz.Title}} · ReqToQuiz</title>
<style>
  :root {
    --bg: #f6f7f9; --surface: #ffffff; --text: #18202b; --muted: #5d6877; --border: #dfe3e8;
    --accent: #4f46e5; --accent-soft: #eef0ff; --ok: #15803d; --ok-soft: #e9f7ee; --bad: #c2410c; --bad-soft: #fdf0e9;
    --radius: 12px;
  }
  @media (prefers-color-scheme: dark) {
    :root {
      --bg: #11151b; --surface: #1a2029; --text: #e7ebf0; --muted: #9aa5b3; --border: #2c3542;
      --accent: #8b85ff; --accent-soft: #24264a; --ok: #4ade80; --ok-soft: #14301f; --bad: #fb923c; --bad-soft: #3a2316;
    }
  }
  * { box-sizing: border-box; }
  body { margin: 0; background: var(--bg); color: var(--text); font: 16px/1.5 system-ui, -apple-system, "Segoe UI", Roboto, sans-serif; }
  .wrap { max-width: 820px; margin: 0 auto; padding: 24px 16px 80px; }
  a { color: var(--accent); }
  header h1 { font-size: 1.6rem; margin: 8px 0 6px; line-height: 1.25; }
  .back { font-size: .9rem; text-decoration: none; }
  .chips { display: flex; flex-wrap: wrap; gap: 6px; margin: 8px 0 0; }
  .chip { font-size: .8rem; padding: 2px 10px; border-radius: 999px; background: var(--accent-soft); color: var(--accent); }
  .toolbar { position: sticky; top: 0; z-index: 5; background: var(--bg); padding: 12px 0; margin: 16px 0 8px; border-bottom: 1px solid var(--border); display: flex; align-items: center; gap: 16px; }
  .progress { flex: 1; }
  .progress-label { font-size: .85rem; color: var(--muted); margin-bottom: 4px; }
  .bar { height: 6px; background: var(--border); border-radius: 999px; overflow: hidden; }
  .bar > div { height: 100%; width: 0; background: var(--accent); transition: width .2s; }
  button { font: inherit; cursor: pointer; border-radius: 8px; border: 1px solid var(--border); background: var(--surface); color: var(--text); padding: 8px 16px; }
  button.primary { background: var(--accent); border-color: var(--accent); color: #fff; font-weight: 600; }
  button:hover { filter: brightness(1.05); }
  .result { display: none; background: var(--surface); border: 1px solid var(--border); border-radius: var(--radius); padding: 24px; margin: 16px 0; text-align: center; }
  .result.show { display: block; }
  .score { font-size: 3.5rem; font-weight: 800; line-height: 1; }
  .score.good { color: var(--ok); } .score.mid { color: var(--accent); } .score.low { color: var(--bad); }
  .score-sub { color: var(--muted); margin: 8px 0 16px; }
  .actions { display: flex; flex-wrap: wrap; gap: 8px; justify-content: center; }
  .q { background: var(--surface); border: 1px solid var(--border); border-radius: var(--radius); padding: 18px 20px; margin: 14px 0; break-inside: avoid; }
  .q.correct { border-color: var(--ok); } .q.wrong { border-color: var(--bad); }
  .q-head { display: flex; align-items: center; gap: 8px; color: var(--muted); font-size: .85rem; margin-bottom: 6px; }
  .q-text { font-weight: 600; white-space: pre-wrap; margin: 0 0 12px; }
  .opt { display: flex; gap: 10px; align-items: flex-start; padding: 10px 12px; border: 1px solid var(--border); border-radius: 8px; margin: 6px 0; cursor: pointer; }
  .opt:hover { border-color: var(--accent); }
  .opt input { margin-top: 4px; accent-color: var(--accent); }
  .opt .letter { font-weight: 700; color: var(--muted); min-width: 1.2em; }
  .opt.selected { border-color: var(--accent); background: var(--accent-soft); }
  .graded .opt { cursor: default; }
  .graded .opt:hover { border-color: var(--border); }
  .opt.is-correct { border-color: var(--ok); background: var(--ok-soft); }
  .opt.is-wrong { border-color: var(--bad); background: var(--bad-soft); }
  .tag { margin-left: auto; font-size: .75rem; font-weight: 700; white-space: nowrap; }
  .is-correct .tag { color: var(--ok); } .is-wrong .tag { color: var(--bad); }
  .explain { display: none; margin-top: 10px; padding: 10px 12px; border-left: 3px solid var(--accent); background: var(--accent-soft); border-radius: 0 8px 8px 0; font-size: .95rem; }
  .graded .explain { display: block; }
  .unanswered-note { display: none; color: var(--bad); font-size: .85rem; font-weight: 600; }
  .graded .q.skipped .unanswered-note { display: inline; }
  footer { margin-top: 24px; text-align: center; }
  .print-only { display: none; }
  @media (max-width: 560px) { .toolbar { flex-direction: column; align-items: stretch; } .score { font-size: 2.8rem; } }
  @media print {
    :root { --bg: #fff; --surface: #fff; --text: #000; --muted: #444; --border: #bbb; --accent: #333; --accent-soft: #f2f2f2; --ok: #0a6b2d; --ok-soft: #fff; --bad: #a33; --bad-soft: #fff; }
    body { font-size: 11pt; }
    .wrap { max-width: none; padding: 0; }
    .toolbar, .actions, .back, footer, .opt input { display: none !important; }
    .print-only { display: block; }
    .result { border: 1px solid #000; padding: 12px; margin: 8px 0 12px; }
    .score { font-size: 28pt; }
    .q { padding: 10px 12px; margin: 8px 0; }
    .opt { padding: 4px 8px; margin: 3px 0; }
    .opt.is-correct, .opt.is-wrong { border-width: 2px; }
  }
</style>
</head>
<body>
<div class="wrap">
  <header>
    <a class="back" href="/" data-i18n="back"></a>
    <h1>{{.Quiz.Title}}</h1>
    <div class="chips" id="chips"></div>
  </header>

  <div class="toolbar">
    <div class="progress">
      <div class="progress-label" id="progress-label"></div>
      <div class="bar"><div id="progress-bar"></div></div>
    </div>
    <button class="primary" id="grade-btn" data-i18n="grade"></button>
  </div>

  <section class="result" id="result">
    <div class="print-only" id="print-date"></div>
    <div class="score" id="score"></div>
    <div class="score-sub" id="score-sub"></div>
    <div class="actions">
      <button class="primary" id="print-btn" data-i18n="print"></button>
      <button id="retry-btn" data-i18n="retry"></button>
      <button id="home-btn" data-i18n="home"></button>
    </div>
  </section>

  <main id="questions"></main>

  <footer><button class="primary" id="grade-btn-bottom" data-i18n="grade"></button></footer>
</div>

<script>
const QUIZ_ID = {{.ID}};
const QUIZ = {{.Quiz}};
const LANG = {{.Lang}};

const T = {
  es: {
    back: "← Volver al inicio", grade: "Corregir", print: "Imprimir respuestas", retry: "Reintentar", home: "Volver al inicio",
    answered: (a, n) => `Respondidas ${a} de ${n}`, question: (i, n) => `Pregunta ${i} de ${n}`,
    confirmMissing: (m) => `Te ${m === 1 ? "falta 1 pregunta" : "faltan " + m + " preguntas"} sin responder. ¿Corregir igual?`,
    result: (c, n) => `${c} de ${n} correctas`, yours: "Tu respuesta", correct: "Correcta", unanswered: "Sin responder",
    questions: "preguntas", printed: (d) => `Impreso el ${d}`,
    diff: { junior: "Junior", semi: "Semi senior", senior: "Senior", mixed: "Dificultad mixta" },
    msg: (p) => p >= 80 ? "¡Excelente! Estás muy bien preparado." : p >= 60 ? "Bien, repasá los temas que fallaste." : "Hay que repasar bastante: mirá las explicaciones.",
  },
  en: {
    back: "← Back to home", grade: "Check answers", print: "Print answers", retry: "Try again", home: "Back to home",
    answered: (a, n) => `Answered ${a} of ${n}`, question: (i, n) => `Question ${i} of ${n}`,
    confirmMissing: (m) => `${m === 1 ? "1 question is" : m + " questions are"} unanswered. Check anyway?`,
    result: (c, n) => `${c} of ${n} correct`, yours: "Your answer", correct: "Correct", unanswered: "Unanswered",
    questions: "questions", printed: (d) => `Printed on ${d}`,
    diff: { junior: "Junior", semi: "Mid level", senior: "Senior", mixed: "Mixed difficulty" },
    msg: (p) => p >= 80 ? "Excellent! You are well prepared." : p >= 60 ? "Good, review the topics you missed." : "Needs more study: read the explanations.",
  },
}[LANG];

const $ = (id) => document.getElementById(id);
const questions = QUIZ.questions.map((q) => ({ ...q, options: [...q.options] }));
let answers = new Array(questions.length).fill(null);
let graded = false;

function el(tag, cls, text) {
  const e = document.createElement(tag);
  if (cls) e.className = cls;
  if (text != null) e.textContent = text;
  return e;
}

function renderChips() {
  const chips = [QUIZ.role, QUIZ.seniority, T.diff[QUIZ.difficulty] || QUIZ.difficulty, `${questions.length} ${T.questions}`];
  $("chips").replaceChildren(...chips.filter(Boolean).map((c) => el("span", "chip", c)));
}

function renderQuestions() {
  const main = $("questions");
  main.replaceChildren();
  questions.forEach((q, qi) => {
    const card = el("article", "q");
    card.id = "q" + qi;
    const head = el("div", "q-head");
    head.append(el("span", null, T.question(qi + 1, questions.length)));
    if (q.topic) head.append(el("span", "chip", q.topic));
    head.append(el("span", "unanswered-note", T.unanswered));
    card.append(head, el("p", "q-text", q.question));
    q.options.forEach((opt, oi) => {
      const label = el("label", "opt");
      const input = document.createElement("input");
      input.type = "radio";
      input.name = "q" + qi;
      input.value = oi;
      input.addEventListener("change", () => { answers[qi] = oi; refresh(); });
      label.append(input, el("span", "letter", "ABCD"[oi] + "."), el("span", null, opt), el("span", "tag"));
      card.append(label);
    });
    card.append(el("div", "explain", q.explanation));
    main.append(card);
  });
}

function refresh() {
  const done = answers.filter((a) => a !== null).length;
  $("progress-label").textContent = T.answered(done, questions.length);
  $("progress-bar").style.width = (done / questions.length) * 100 + "%";
  questions.forEach((q, qi) => {
    document.querySelectorAll(`#q${qi} .opt`).forEach((label, oi) => label.classList.toggle("selected", !graded && answers[qi] === oi));
  });
}

function grade() {
  const missing = answers.filter((a) => a === null).length;
  if (missing > 0 && !confirm(T.confirmMissing(missing))) {
    const first = answers.indexOf(null);
    $("q" + first).scrollIntoView({ behavior: "smooth", block: "center" });
    return;
  }
  graded = true;
  document.body.classList.add("graded");
  let correct = 0;
  questions.forEach((q, qi) => {
    const card = $("q" + qi);
    const ok = answers[qi] === q.answer;
    if (ok) correct++;
    card.classList.add(ok ? "correct" : "wrong");
    if (answers[qi] === null) card.classList.add("skipped");
    card.querySelectorAll(".opt").forEach((label, oi) => {
      label.querySelector("input").disabled = true;
      const tag = label.querySelector(".tag");
      if (oi === q.answer) { label.classList.add("is-correct"); tag.textContent = "✓ " + T.correct; }
      if (oi === answers[qi] && oi !== q.answer) { label.classList.add("is-wrong"); tag.textContent = "✗ " + T.yours; }
      if (oi === answers[qi] && oi === q.answer) tag.textContent = "✓ " + T.yours;
    });
  });
  const pct = Math.round((correct / questions.length) * 100);
  const score = $("score");
  score.textContent = pct + "%";
  score.className = "score " + (pct >= 80 ? "good" : pct >= 60 ? "mid" : "low");
  $("score-sub").textContent = `${T.result(correct, questions.length)} · ${T.msg(pct)}`;
  $("print-date").textContent = T.printed(new Date().toLocaleString(LANG));
  $("result").classList.add("show");
  $("grade-btn").style.display = "none";
  $("grade-btn-bottom").style.display = "none";
  refresh();
  window.scrollTo({ top: 0, behavior: "smooth" });
  saveAttempt(pct, correct);
}

function saveAttempt(score, correct) {
  if (!location.protocol.startsWith("http")) return;
  fetch(`/api/quizzes/${QUIZ_ID}/attempts`, {
    method: "POST",
    headers: { "Content-Type": "application/json" },
    body: JSON.stringify({ score, correct, total: questions.length }),
  }).catch(() => {});
}

function retry() {
  graded = false;
  answers = new Array(questions.length).fill(null);
  questions.forEach((q) => {
    const right = q.options[q.answer];
    for (let i = q.options.length - 1; i > 0; i--) {
      const j = Math.floor(Math.random() * (i + 1));
      [q.options[i], q.options[j]] = [q.options[j], q.options[i]];
    }
    q.answer = q.options.indexOf(right);
  });
  document.body.classList.remove("graded");
  $("result").classList.remove("show");
  $("grade-btn").style.display = "";
  $("grade-btn-bottom").style.display = "";
  renderQuestions();
  refresh();
  window.scrollTo({ top: 0, behavior: "smooth" });
}

document.querySelectorAll("[data-i18n]").forEach((e) => (e.textContent = T[e.dataset.i18n]));
$("grade-btn").addEventListener("click", grade);
$("grade-btn-bottom").addEventListener("click", grade);
$("print-btn").addEventListener("click", () => window.print());
$("retry-btn").addEventListener("click", retry);
$("home-btn").addEventListener("click", () => (location.href = "/"));
renderChips();
renderQuestions();
refresh();
</script>
</body>
</html>
