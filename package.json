{
  "name": "reqtoquiz",
  "private": true,
  "description": "Genera quizzes multiple choice desde el requerimiento de un puesto usando Claude Code",
  "scripts": {
    "setup": "npm install && npm --prefix frontend install",
    "dev": "concurrently -k -n api,web -c blue,magenta \"npm:dev:api\" \"npm:dev:web\"",
    "dev:api": "cd backend && go run .",
    "dev:web": "npm --prefix frontend run dev",
    "build": "npm --prefix frontend run build && cd backend && go build -o ../reqtoquiz.exe .",
    "start": "node -e \"require('child_process').spawn(process.platform==='win32'?'reqtoquiz.exe':'./reqtoquiz.exe',['-open'],{stdio:'inherit'})\"",
    "test": "cd backend && go test ./..."
  },
  "devDependencies": {
    "concurrently": "^9.2.5"
  }
}
